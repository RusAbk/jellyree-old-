{
  "name": "jellyree-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Cloudflare R2 + D1 drive without an application server",
  "author": "Jellyree",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "node scripts/build.mjs",
    "test:smoke": "node test/smoke.mjs",
    "format": "prettier --write src electron scripts test vite.config.ts",
    "dist:linux": "node scripts/build.mjs linux",
    "dist:win": "node scripts/build.mjs win",
    "dist:mac": "node scripts/build.mjs mac",
    "test:editor": "node test/editor-smoke.mjs",
    "test:thumbnails": "node test/thumbnail-smoke.mjs",
    "test:thumbnail-stress": "node test/thumbnail-stress.mjs",
    "test:video": "node test/video-smoke.mjs",
    "test:documents": "node test/document-smoke.mjs",
    "test:heic": "node test/heic-smoke.mjs",
    "test:pxz": "node test/pxz-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@aws-sdk/lib-storage": "^3.998.0",
    "@aws-sdk/s3-request-presigner": "^3.998.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@zip.js/zip.js": "^2.25.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.5.0",
    "exifreader": "^4.55.1",
    "libheif-js": "^1.23.5",
    "marked": "^18.2.1",
    "mime": "^4.1.0",
    "pdfjs-dist": "^6.5.438",
    "remixicon": "^4.9.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vue-tsc": "^3.1.5"
  },
  "build": {
    "appId": "app.jellyree.desktop",
    "productName": "Jellyree",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  }
}
