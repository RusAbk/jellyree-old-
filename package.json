{
  "name": "jellyree",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run start:dev -w server",
    "build:web": "npm run build -w web",
    "build:server": "npm run build -w server",
    "dev:desktop": "npm --prefix desktop run dev",
    "build:desktop": "npm --prefix desktop run build",
    "test:desktop": "npm --prefix desktop test",
    "dist:desktop": "npm --prefix desktop run dist --",
    "dist:desktop:linux": "npm --prefix desktop run dist:linux --",
    "dist:desktop:win": "npm --prefix desktop run dist:win --",
    "dist:desktop:mac": "npm --prefix desktop run dist:mac --"
  }
}
